{
  "expo": {
    "name": "TireTrack",
    "slug": "tiretrack",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tiretrack",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "android": {
      "package": "app.tiretrack.campo",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#1A1D23"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "TireTrack usa la cámara para registrar el estado de las llantas en la orden de servicio.",
          "photosPermission": "TireTrack accede a tus fotos solo si eliges una imagen ya tomada para adjuntarla a una orden.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "app.tiretrack.campo",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "TireTrack usa la cámara para registrar el estado de las llantas en la orden de servicio.",
        "NSPhotoLibraryUsageDescription": "TireTrack accede a tus fotos solo si eliges una imagen ya tomada para adjuntarla a una orden."
      }
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/4ce8f57b-b359-4236-b082-6219e722a1b8"
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "./app"
      },
      "eas": {
        "projectId": "4ce8f57b-b359-4236-b082-6219e722a1b8"
      }
    },
    "owner": "adrianb2ya",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
