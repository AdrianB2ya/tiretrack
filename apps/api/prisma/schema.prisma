// ============================================================================
// TireTrack — Esquema de base de datos
// ============================================================================
// Reglas estructurales que verifica apps/api/src/schema.test.ts:
//   1. Toda tabla operativa lleva empresaId.
//   2. Todo índice de tabla operativa empieza por empresaId: es el primer
//      filtro de cualquier consulta.
//   3. Dinero y mediciones en Decimal, nunca Float: Float produce errores de
//      redondeo que terminan en una factura.
//   4. Los ids son String generados en el CLIENTE, no @default(uuid()): es lo
//      que permite capturar sin conexión y sincronizar sin duplicar.
//   5. Nada se borra: hay columna de desactivación.
//
// Las llaves foráneas compuestas y los CHECK van en migrations/manual.sql:
// Prisma no las genera y son las que hacen imposible cruzar datos entre
// empresas.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════════════════════════════════════
// EMPRESA — el tenant
// ════════════════════════════════════════════════════════════════════════════

enum PlanSuscripcion {
  trial
  basico
  profesional
  enterprise
}

enum UnidadPresion {
  psi
  bar
  kpa
}

enum UnidadProfundidad {
  mm
  in32
}

model Empresa {
  id                String            @id
  nombre            String
  nit               String            @unique
  nitSecundario     String?
  plan              PlanSuscripcion   @default(trial)
  unidadPresion     UnidadPresion     @default(psi)
  unidadProfundidad UnidadProfundidad @default(mm)
  moneda            String            @default("COP")
  zonaHoraria       String            @default("America/Bogota")
  /// Límites de cambio de llanta (R2), en mm. A esta profundidad o menos,
  /// cambio inmediato; hasta programarCambio, preventivo. El mínimo de cada
  /// eje de la plantilla manda sobre ellos cuando está definido.
  limiteCambioInmediato Decimal     @default(3) @db.Decimal(5, 2)
  limiteProgramarCambio Decimal     @default(5) @db.Decimal(5, 2)
  /// Día (Colombia, AAAA-MM-DD) del último resumen de llantas para cambio
  /// enviado a la oficina (R13): uno por día.
  ultimoAvisoCambios String?
  activa            Boolean           @default(true)
  creadoEn          DateTime          @default(now())
  actualizadoEn     DateTime          @updatedAt
  desactivadoEn     DateTime?

  sedes           Sede[]
  usuarios        Usuario[]
  clientes        Cliente[]
  configuraciones ConfiguracionEje[]
  marcas          Marca[]
  medidas         DisenoMedida[]
  servicios       Servicio[]
  tiposParche     TipoParche[]
  ordenes         OrdenServicio[]
  consecutivos    Consecutivo[]
  recomendaciones Recomendacion[]
  programaciones  ProgramacionRecurrente[]
  auditorias      Auditoria[]

  @@index([activa])
}

// ════════════════════════════════════════════════════════════════════════════
// SEDES DE LA EMPRESA
// ════════════════════════════════════════════════════════════════════════════

model Sede {
  id            String    @id
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  nombre        String
  /// Entra en el folio: OS-FUN-000123
  codigo        String
  direccion     String?
  ciudad        String?
  departamento  String?
  nitSecundario String?
  activa        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  desactivadoEn DateTime?

  usuarios       UsuarioSede[]
  ordenes        OrdenServicio[]
  consecutivos   Consecutivo[]
  programaciones ProgramacionRecurrente[]

  @@unique([empresaId, codigo])
  /// Ancla de la FK compuesta que impide emitir una orden desde otra empresa
  @@unique([id, empresaId])
  @@index([empresaId, activa])
}

// ════════════════════════════════════════════════════════════════════════════
// USUARIOS Y ACCESO
// ════════════════════════════════════════════════════════════════════════════

enum Rol {
  superadmin
  administrador
  coordinador
  tecnico
  cliente
}

model Usuario {
  id String @id
  /// null SOLO para superadmin: es staff de plataforma, no de una empresa
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])
  nombre       String
  cedula       String
  email        String
  telefono     String?
  passwordHash String
  rol          Rol      @default(tecnico)
  /// Obligatorio cuando rol = cliente: limita lo que puede ver
  clienteId    String?
  cliente      Cliente? @relation(fields: [clienteId], references: [id])
  activo       Boolean  @default(true)

  passwordActualizadoEn DateTime  @default(now())
  intentosFallidos      Int       @default(0)
  bloqueadoHasta        DateTime?
  dobleFactorActivo     Boolean   @default(false)
  dobleFactorSecreto    String?
  ultimoAcceso          DateTime?

  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  desactivadoEn DateTime?

  sedes               UsuarioSede[]
  tokensRecuperacion  TokenRecuperacion[]
  sesiones            SesionUsuario[]
  suplantaciones      SesionSuplantacion[]  @relation("Suplantador")
  ordenesAsignadas    OrdenServicio[]       @relation("TecnicoOrden")
  ordenesCreadas      OrdenServicio[]       @relation("CreadorOrden")
  ordenesAprobadas    OrdenServicio[]       @relation("AprobadorOrden")
  programacionesAsignadas ProgramacionRecurrente[] @relation("TecnicoProgramacion")
  programacionesCreadas   ProgramacionRecurrente[] @relation("CreadorProgramacion")
  medicionesCapturadas LlantaRegistro[]     @relation("CapturadorLlanta")
  recomendaciones     Recomendacion[]

  /// Email único POR empresa: la misma persona puede existir en dos tenants
  @@unique([empresaId, email])
  @@unique([empresaId, cedula])
  @@index([empresaId, rol, activo])
}

/// Un técnico rota entre sedes: la relación es de muchos a muchos.
model UsuarioSede {
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sedeId      String
  sede        Sede     @relation(fields: [sedeId], references: [id], onDelete: Cascade)
  esPrincipal Boolean  @default(false)
  activa      Boolean  @default(true)
  asignadoEn  DateTime @default(now())

  @@id([usuarioId, sedeId])
  /// Destino de la FK compuesta: impide asignar una orden a un técnico que
  /// no pertenece a esa sede
  @@unique([usuarioId, sedeId], name: "usuario_sede_uk")
}

/// Token de un solo uso. Se guarda el HASH, nunca el token en claro.
model TokenRecuperacion {
  id          String    @id
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiraEn    DateTime
  usadoEn     DateTime?
  ipSolicitud String?
  creadoEn    DateTime  @default(now())

  @@index([usuarioId])
}

/// Permite revocar sesiones al cambiar contraseña o dar de baja al usuario.
model SesionUsuario {
  id          String    @id
  usuarioId   String
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  dispositivo String?
  ip          String?
  expiraEn    DateTime
  revocadaEn  DateTime?
  creadoEn    DateTime  @default(now())

  @@index([usuarioId, revocadaEn])
}

/// El superadmin no accede a datos operativos sin abrir una sesión de
/// soporte con motivo, ticket y vencimiento. Todo lo que haga queda marcado.
model SesionSuplantacion {
  id            String    @id
  superadminId  String
  superadmin    Usuario   @relation("Suplantador", fields: [superadminId], references: [id])
  empresaId     String
  motivo        String
  ticketSoporte String?
  iniciadaEn    DateTime  @default(now())
  expiraEn      DateTime
  terminadaEn   DateTime?

  @@index([empresaId, iniciadaEn])
}

// ════════════════════════════════════════════════════════════════════════════
// CLIENTES Y SUS ACTIVOS
// ════════════════════════════════════════════════════════════════════════════

model Cliente {
  id            String    @id
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  nombre        String
  /// Único POR empresa. El mismo NIT existe aparte en otra empresa:
  /// los clientes NO se comparten entre empresas suscritas.
  nit           String
  nitSecundario String?
  contacto      String?
  telefono      String?
  email         String?
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  desactivadoEn DateTime?

  sedes           SedeCliente[]
  ordenes         OrdenServicio[]
  usuarios        Usuario[]
  recomendaciones Recomendacion[]
  programaciones  ProgramacionRecurrente[]

  @@unique([empresaId, nit])
  /// Ancla de la FK compuesta orden → cliente → empresa
  @@unique([id, empresaId])
  @@index([empresaId, activo])
}

model SedeCliente {
  id            String    @id
  clienteId     String
  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  nombre        String
  direccion     String?
  ciudad        String?
  departamento  String?
  telefono      String?
  nitSecundario String?
  activa        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  desactivadaEn DateTime?

  vehiculos      Vehiculo[]
  ordenes        OrdenServicio[]
  programaciones ProgramacionRecurrente[]

  /// Ancla de la FK compuesta orden → sedeCliente → cliente
  @@unique([id, clienteId])
  @@index([clienteId, activa])
}

// ════════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN DE EJES — inmutable y versionada
// ════════════════════════════════════════════════════════════════════════════

/// Las plantillas NUNCA se editan: editar crea una versión nueva. La orden
/// congela el id de la versión que usó, para que una orden de hace seis meses
/// se siga dibujando con el diagrama que tenía ese día.
model ConfiguracionEje {
  id               String   @id
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  nombre           String
  version          Int      @default(1)
  totalPosiciones  Int
  vigente          Boolean  @default(true)
  reemplazadaPorId String?
  creadoEn         DateTime @default(now())

  posiciones PosicionEje[]
  vehiculos  Vehiculo[]
  ordenes    OrdenServicio[]

  @@unique([empresaId, nombre, version])
  /// Ancla para que LlantaRegistro valide su posición contra la misma
  /// configuración que congeló la orden
  @@unique([id, empresaId])
  @@index([empresaId, vigente])
}

enum LadoVehiculo {
  izquierdo
  derecho
}

/// Cada casilla del diagrama. Los umbrales viven aquí porque dependen del
/// eje: una direccional trabaja a 110 PSI y una de tracción a 105.
model PosicionEje {
  id                 String           @id
  configuracionEjeId String
  configuracionEje   ConfiguracionEje @relation(fields: [configuracionEjeId], references: [id], onDelete: Cascade)
  numero             Int
  eje                Int
  lado               LadoVehiculo
  esInterna          Boolean          @default(false)
  esDireccional      Boolean          @default(false)
  tipoEje            String           @default("multiuso")
  psiObjetivo        Decimal?         @db.Decimal(6, 2)
  profundidadMinima  Decimal?         @db.Decimal(5, 2)

  registros LlantaRegistro[]

  @@unique([configuracionEjeId, numero])
  @@index([configuracionEjeId])
}

enum EstadoVehiculo {
  operativo
  en_taller
  alerta
  fuera_servicio
}

/// El vehículo pertenece a la SEDE del cliente, no al cliente.
model Vehiculo {
  id                 String           @id
  sedeClienteId      String
  sedeCliente        SedeCliente      @relation(fields: [sedeClienteId], references: [id])
  configuracionEjeId String
  configuracionEje   ConfiguracionEje @relation(fields: [configuracionEjeId], references: [id])
  codigo             String
  placa              String?
  nombre             String
  tipo               String
  marca              String?
  modelo             String?
  anio               Int?
  kmActual           Int              @default(0)
  /// Cuántas llantas de repuesto lleva (dominio llanta/repuestos). No depende
  /// de la plantilla: lo recuerda de la última inspección.
  repuestos          Int              @default(0)
  ultimoPM           DateTime?
  proximoPM          DateTime?
  estado             EstadoVehiculo   @default(operativo)
  activo             Boolean          @default(true)
  creadoEn           DateTime         @default(now())
  actualizadoEn      DateTime         @updatedAt
  desactivadoEn      DateTime?

  ordenes         OrdenServicio[]
  recomendaciones Recomendacion[]
  programaciones  ProgramacionRecurrente[]

  @@unique([sedeClienteId, codigo])
  @@index([sedeClienteId, activo])
}

// ════════════════════════════════════════════════════════════════════════════
// CATÁLOGO DE LLANTAS — marca → diseño → medida
// ════════════════════════════════════════════════════════════════════════════

/// Ámbito híbrido: las globales (empresaId null) las mantiene la plataforma
/// y las ve todo el mundo; las propias solo su empresa. Sin catálogo, en tres
/// meses hay cuatro variantes de "Michelin" y el análisis por marca muere.
model Marca {
  id            String    @id
  empresaId     String?
  empresa       Empresa?  @relation(fields: [empresaId], references: [id])
  nombre        String
  esGlobal      Boolean   @default(false)
  /// Creada por un técnico en campo: pendiente de revisión del administrador
  creadaEnCampo Boolean   @default(false)
  activa        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  desactivadoEn DateTime?
  /// Duplicada unificada por el administrador: alias de esta. Las mediciones
  /// conservan lo que se escribió; los informes agrupan por la correcta.
  reemplazadaPorId String?
  reemplazadaPor   Marca?  @relation("MarcaUnificada", fields: [reemplazadaPorId], references: [id])
  unificadas       Marca[] @relation("MarcaUnificada")

  disenos Diseno[]

  @@unique([empresaId, nombre])
  @@index([empresaId, activa])
}

model Diseno {
  id            String    @id
  empresaId     String?
  marcaId       String
  marca         Marca     @relation(fields: [marcaId], references: [id])
  nombre        String
  /// direccional | traccion | arrastre | multiuso
  tipoEje       String    @default("multiuso")
  esGlobal      Boolean   @default(false)
  creadaEnCampo Boolean   @default(false)
  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  desactivadoEn DateTime?
  /// Igual que en Marca: alias del diseño correcto.
  reemplazadoPorId String?
  reemplazadoPor   Diseno?  @relation("DisenoUnificado", fields: [reemplazadoPorId], references: [id])
  unificados       Diseno[] @relation("DisenoUnificado")

  medidas DisenoMedida[]

  @@unique([marcaId, nombre])
  @@index([marcaId, activo])
}

/// La profundidad de fábrica vive en la MEDIDA, no en el diseño: un XZY-3 en
/// 295/80R22.5 trae 16 mm y en 11R22.5 trae 14.5. Guardarla en el diseño hace
/// que el porcentaje de desgaste salga mal en flotas con dos medidas.
model DisenoMedida {
  id                  String   @id
  /// null: del catálogo general. Con valor: propia de esa empresa, aunque
  /// cuelgue de un diseño global (una empresa agrega una medida a Michelin
  /// XZE y las demás no la ven).
  empresaId           String?
  empresa             Empresa? @relation(fields: [empresaId], references: [id])
  disenoId            String
  diseno              Diseno   @relation(fields: [disenoId], references: [id], onDelete: Cascade)
  medida              String
  profundidadOriginal Decimal? @db.Decimal(5, 2)
  /// Creada en campo: pendiente de revisión del administrador.
  creadaEnCampo       Boolean  @default(false)
  creadoEn            DateTime @default(now())

  @@unique([disenoId, empresaId, medida])
  @@index([empresaId, disenoId])
}

model Servicio {
  id        String   @id
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  codigo    String
  nombre    String
  /// Distingue los que se marcan por posición de los del vehículo completo
  porLlanta Boolean  @default(true)
  orden     Int      @default(0)
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  serviciosLlanta LlantaServicio[]

  @@unique([empresaId, codigo])
  @@index([empresaId, activo])
}

model TipoParche {
  id        String   @id
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nombre    String
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  registros LlantaRegistro[]

  @@unique([empresaId, nombre])
  @@index([empresaId, activo])
}

// ════════════════════════════════════════════════════════════════════════════
// ORDEN DE SERVICIO
// ════════════════════════════════════════════════════════════════════════════

enum TipoServicio {
  preventivo
  correctivo
  /// Inspección de la flota (R4)
  levantamiento
}

enum Prioridad {
  baja
  normal
  alta
}

enum EstadoOrden {
  borrador
  programada
  en_proceso
  en_revision
  pendiente_cliente
  cerrada
  anulada
}

model OrdenServicio {
  /// UUID generado en el DISPOSITIVO, no en el servidor
  id        String  @id
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  sedeId    String
  sede      Sede    @relation(fields: [sedeId], references: [id])

  clienteId     String
  cliente       Cliente     @relation(fields: [clienteId], references: [id])
  sedeClienteId String
  sedeCliente   SedeCliente @relation(fields: [sedeClienteId], references: [id])
  vehiculoId    String
  vehiculo      Vehiculo    @relation(fields: [vehiculoId], references: [id])

  tecnicoId String  @map("tecnico_id")
  tecnico   Usuario @relation("TecnicoOrden", fields: [tecnicoId], references: [id])

  /// Versión de la plantilla de ejes CONGELADA al crear la orden
  configuracionEjeId String
  configuracionEje   ConfiguracionEje @relation(fields: [configuracionEjeId], references: [id])

  /// Null hasta que sincroniza, en órdenes creadas sin señal
  folio String?
  /// Referencia temporal de las imprevistas: FUN-K7M2
  codigoReferencia String?
  /// Orden anterior al sistema, cargada desde Excel: cerrada y sin firma
  /// digital (CHECK orden_cerrada_requiere_firma la exime solo a ella).
  historica          Boolean @default(false)
  /// Número que tenía en el papel o en el sistema anterior.
  referenciaAnterior String?

  tipo      TipoServicio
  prioridad Prioridad    @default(normal)
  estado    EstadoOrden  @default(borrador)
  fecha     DateTime     @db.Date

  kilometraje      Int?
  hallazgos        String?
  accion           String?
  observaciones    String?
  notaCoordinador  String?
  motivoDevolucion String?
  horasTrabajo     Decimal @default(0) @db.Decimal(6, 2)

  sinConductor    Boolean @default(false)
  conductorNombre String?
  conductorCedula String?

  // ── Firma: se ata a la versión. Si el contenido cambia después, deja de
  //    amparar lo que quedó y hay que recapturarla.
  firmaNombre    String?
  firmaCedula    String?
  firmaUrl       String?
  firmaVersion   Int?
  firmaFechaHora DateTime?
  firmaCargo     String?
  /// Segmentos del trazo serializados. Se guardan puntos, no una imagen:
  /// ocupan menos y se redibujan a cualquier tamaño, incluido el PDF.
  firmaTrazo     String?
  /// Versión del texto de consentimiento aceptado (Ley 1581). Sin ella no hay
  /// constancia de qué autorizó la persona.
  firmaConsentimiento String?

  // ── Congelado al cerrar: un documento no cambia solo
  clienteNombre     String?
  clienteNit        String?
  sedeClienteNombre String?
  vehiculoCodigo    String?
  vehiculoPlaca     String?
  tecnicoNombre     String?
  tecnicoCedula     String?
  congeladoEn       DateTime?

  // ── Aprobación
  aprobadoPorId    String?
  aprobadoPor      Usuario?  @relation("AprobadorOrden", fields: [aprobadoPorId], references: [id])
  aprobadoEn       DateTime?
  autoAprobada     Boolean   @default(false)
  enviadoClienteEn DateTime? @db.Date
  limiteCliente    DateTime? @db.Date
  /// Cuándo se avisó por correo al cliente que espera su aprobación (R13).
  avisoClienteEn   DateTime?
  cierreTacito     Boolean   @default(false)
  motivoCierre     String?

  /// Bloqueo (R7): el técnico asignado se la lleva para trabajar sin señal.
  /// Mientras lo tenga, la oficina solo la ve; para reasignar o anular, la
  /// libera primero. Se libera sola al enviarla a revisión.
  bloqueadaPorId   String?
  bloqueadaEn      DateTime?

  /// Bloqueo optimista: sube en TODA escritura. Si el cliente envía una
  /// versión vieja, se rechaza en vez de pisar el trabajo del otro usuario.
  version Int @default(0)

  /// Sube solo cuando cambia el CONTENIDO del servicio: mediciones,
  /// kilometraje, hallazgos, acción. La firma se ata a este contador, no a
  /// `version`: mover la orden de estado no debe invalidar una firma, porque
  /// el documento que el cliente firmó no cambió.
  versionContenido Int @default(0)

  /// Idempotencia de la sincronización: reintentar no duplica la orden
  clientRequestId String?
  sincronizadoEn  DateTime?

  creadoPorId   String
  creadoPor     Usuario   @relation("CreadorOrden", fields: [creadoPorId], references: [id])
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt
  anuladaEn     DateTime?

  llantas          LlantaRegistro[]
  serviciosVehiculo OrdenServicioVehiculo[]
  historial        OrdenEstadoHistorial[]
  fotos            Foto[]
  recomendaciones  Recomendacion[]

  @@unique([empresaId, folio])
  @@unique([empresaId, clientRequestId])
  /// Ancla para que la posición de llanta se valide contra la configuración
  /// que esta orden congeló
  @@unique([id, configuracionEjeId])
  @@index([empresaId, estado])
  @@index([empresaId, tecnicoId, estado])
  @@index([empresaId, clienteId, fecha])
  @@index([empresaId, vehiculoId, estado])
}

/// Servicios que aplican al vehículo completo, no a una posición.
model OrdenServicioVehiculo {
  ordenId    String
  orden      OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  servicioId String

  @@id([ordenId, servicioId])
}

/// Rastro de transiciones con motivo. El cliente no ve las devoluciones
/// internas entre coordinador y técnico.
model OrdenEstadoHistorial {
  id             String        @id
  ordenId        String
  orden          OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  estadoAnterior EstadoOrden?
  estadoNuevo    EstadoOrden
  /// Vacío = Sistema (cierre tácito, orden recurrente): una acción automática
  /// nunca se atribuye a una persona.
  usuarioId      String?
  motivo         String?
  visibleCliente Boolean       @default(false)
  creadoEn       DateTime      @default(now())

  @@index([ordenId, creadoEn])
}

// ════════════════════════════════════════════════════════════════════════════
// MEDICIÓN POR POSICIÓN
// ════════════════════════════════════════════════════════════════════════════

/// Tabla propia, no un objeto dentro de la orden: el técnico sincroniza
/// posición por posición, y si se cae la señal a mitad de captura no puede
/// perder todo lo anterior.
model LlantaRegistro {
  id      String        @id
  ordenId String
  orden   OrdenServicio @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  /// Se repite aquí para poder validar la posición contra la configuración
  /// que la orden congeló, con FK compuesta
  configuracionEjeId String
  /// 1 a 60 en un eje; 101 en adelante, un repuesto (fuera del diagrama).
  posicion           Int
  /// La misma posición si es de un eje; nula si es un repuesto. La llave
  /// hacia la plantilla va por aquí: un repuesto no existe en ella, y con la
  /// columna nula la llave no se comprueba (CHECK en la migración).
  posicionEnEje      Int?
  posicionEje        PosicionEje? @relation(fields: [configuracionEjeId, posicionEnEje], references: [configuracionEjeId, numero])

  /// El activo medido y el que salió (R8). Nulos si la llanta no se pudo
  /// identificar: un dato faltante no se inventa.
  llantaId     String?
  desLlantaId  String?
  /// Costo de la llanta, capturado en el levantamiento (R9). Dinero: Decimal.
  costo        Decimal? @db.Decimal(14, 2)
  /// Por qué salió la llanta desmontada (R10, dominio llanta/retiro).
  desMotivoRetiro String?

  marcaId      String?
  disenoId     String?
  medida       String?
  numCalor     String?
  serial       String?
  /// Semana y año de fabricación: 3624. El vencimiento se calcula a 6 años
  dot          String?
  estadoLlanta String?

  numParche    String?
  tipoParcheId String?
  tipoParche   TipoParche? @relation(fields: [tipoParcheId], references: [id])

  psiEncontrada Decimal? @db.Decimal(6, 2)
  psiCalibrado  Decimal? @db.Decimal(6, 2)
  /// La mínima de las tres medidas: la que usan desgaste, alertas e informe.
  profundidad   Decimal? @db.Decimal(5, 2)
  profExterior  Decimal? @db.Decimal(5, 2)
  profCentro    Decimal? @db.Decimal(5, 2)
  profInterior  Decimal? @db.Decimal(5, 2)

  observaciones String?

  /// Cuando el flanco está borrado o la llanta es interna. Sin esta salida
  /// explícita el técnico inventaría un dato, y un dato inventado es peor
  /// que uno faltante.
  noIdentificada       Boolean @default(false)
  motivoNoIdentificada String?
  notaNoIdentificada   String?

  // ── Llanta que SALE de la posición. Se autocompleta desde la última orden
  //    que registró esta posición.
  desPosicionOrigen Int?
  desMarcaId        String?
  desDisenoId       String?
  desMedida         String?
  desNumCalor       String?
  desSerial         String?
  desDot            String?
  desProfundidad    Decimal? @db.Decimal(5, 2)
  desProfExterior   Decimal? @db.Decimal(5, 2)
  desProfCentro     Decimal? @db.Decimal(5, 2)
  desProfInterior   Decimal? @db.Decimal(5, 2)
  desDestino        String?
  desDetalle        String?

  /// Autoría de la medición. Sobrevive a la reasignación de la orden: si el
  /// coordinador pasa la orden a otro técnico, esto no cambia.
  capturadoPorId String
  capturadoPor   Usuario  @relation("CapturadorLlanta", fields: [capturadoPorId], references: [id])
  capturadoEn    DateTime @default(now())

  version       Int      @default(0)
  actualizadoEn DateTime @updatedAt

  servicios LlantaServicio[]
  fotos     Foto[]

  @@unique([ordenId, posicion])
  @@index([ordenId])
  @@index([serial])
  @@index([desSerial])
}

model LlantaServicio {
  llantaRegistroId String
  llantaRegistro   LlantaRegistro @relation(fields: [llantaRegistroId], references: [id], onDelete: Cascade)
  servicioId       String
  servicio         Servicio       @relation(fields: [servicioId], references: [id])

  @@id([llantaRegistroId, servicioId])
}

/// Foto del trabajo completo O de una posición. Exactamente una de las dos
/// FK debe estar presente: el CHECK va en migrations/manual.sql.
model Foto {
  id               String          @id
  ordenId          String?
  orden            OrdenServicio?  @relation(fields: [ordenId], references: [id], onDelete: Cascade)
  llantaRegistroId String?
  llantaRegistro   LlantaRegistro? @relation(fields: [llantaRegistroId], references: [id], onDelete: Cascade)
  /// Ruta dentro del bucket. El archivo NUNCA pasa por la API: el
  /// dispositivo sube directo con una URL firmada.
  ruta             String
  nombre           String
  tamanoBytes      Int?
  subidaPorId      String?
  /// false hasta comprobar que el archivo llegó al bucket. Una foto sin
  /// confirmar no existe para el usuario: el cliente puede decir que subió
  /// sin haberlo hecho.
  confirmada       Boolean         @default(false)
  creadoEn         DateTime        @default(now())
  subidaEn         DateTime?

  @@index([ordenId])
  @@index([llantaRegistroId])
  @@index([confirmada, creadoEn])
}

// ════════════════════════════════════════════════════════════════════════════
// RECOMENDACIONES — sobreviven al cierre de la orden
// ════════════════════════════════════════════════════════════════════════════

enum PrioridadRecomendacion {
  urgente
  proxima
  seguimiento
}

enum EstadoRecomendacion {
  abierta
  ejecutada
  descartada
}

/// Lo que el técnico encuentra y no ejecuta. Queda vivo en el vehículo y
/// reaparece en la siguiente orden hasta que alguien la atienda: es la
/// diferencia entre un formulario y un servicio.
model Recomendacion {
  id         String   @id
  empresaId  String
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  clienteId  String
  cliente    Cliente  @relation(fields: [clienteId], references: [id])
  vehiculoId String
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])
  posicion   Int?

  texto      String
  prioridad  PrioridadRecomendacion @default(proxima)
  estado     EstadoRecomendacion    @default(abierta)

  origenOrdenId String
  origenOrden   OrdenServicio @relation(fields: [origenOrdenId], references: [id])
  creadaPorId   String
  creadaPor     Usuario       @relation(fields: [creadaPorId], references: [id])
  creadaEn      DateTime      @default(now())

  resueltaEn      DateTime?
  resueltaOrdenId String?

  @@index([empresaId, vehiculoId, estado])
  @@index([empresaId, estado, prioridad])
}

// ════════════════════════════════════════════════════════════════════════════
// PROGRAMACIÓN RECURRENTE
// ════════════════════════════════════════════════════════════════════════════

enum Frecuencia {
  dias_habiles
  dias_calendario
  semanal
  quincenal
  mensual
}

model ProgramacionRecurrente {
  id            String       @id
  empresaId     String
  empresa       Empresa      @relation(fields: [empresaId], references: [id])
  sedeId        String
  sede          Sede         @relation(fields: [sedeId], references: [id])
  clienteId     String
  cliente       Cliente      @relation(fields: [clienteId], references: [id])
  sedeClienteId String
  sedeCliente   SedeCliente  @relation(fields: [sedeClienteId], references: [id])
  vehiculoId    String
  vehiculo      Vehiculo     @relation(fields: [vehiculoId], references: [id])
  /// Técnico fijo: la orden le llega directo (decisión del usuario, 2026-10-06).
  tecnicoId     String
  tecnico       Usuario      @relation("TecnicoProgramacion", fields: [tecnicoId], references: [id])
  /// Quien la programó: figura como creador de cada orden que genera.
  creadoPorId   String
  creadoPor     Usuario      @relation("CreadorProgramacion", fields: [creadoPorId], references: [id])
  tipo          TipoServicio
  frecuencia    Frecuencia
  cada          Int          @default(1)
  inicio        DateTime     @db.Date
  proxima       DateTime     @db.Date
  activa        Boolean      @default(true)
  /// Por qué no se generó la última vez (técnico inactivo, orden abierta…).
  /// Sin esto, una programación que no produce nada parece que funciona.
  ultimoAviso   String?
  creadoEn      DateTime     @default(now())
  desactivadoEn DateTime?

  @@index([empresaId, activa, proxima])
}

// ════════════════════════════════════════════════════════════════════════════
// CONSECUTIVOS Y AUDITORÍA
// ════════════════════════════════════════════════════════════════════════════

/// Contador atómico por sede:
///   UPDATE consecutivo SET valor = valor + 1 WHERE ... RETURNING valor;
/// Nunca count()+1: dos técnicos simultáneos obtendrían el mismo folio.
model Consecutivo {
  id        String  @id
  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])
  sedeId    String
  sede      Sede    @relation(fields: [sedeId], references: [id])
  tipo      String  @default("OS")
  prefijo   String  @default("OS")
  valor     Int     @default(0)

  @@unique([empresaId, sedeId, tipo])
}

enum AccionAuditoria {
  crear
  actualizar
  deshabilitar
  cambiar_estado
  reasignar
  aprobar
  anular
  login_exitoso
  login_fallido
  recuperar_password
  suplantar_empresa
  exportar_informe
  exportar_listado
}

/// Toda salida de datos queda registrada: sin esto, una fuga no tiene rastro.
model Auditoria {
  id              String          @id
  empresaId       String?
  empresa         Empresa?        @relation(fields: [empresaId], references: [id])
  usuarioId       String?
  usuarioNombre   String?
  rol             String?
  entidad         String?
  entidadId       String?
  accion          AccionAuditoria
  /// Diff o detalle: en exportaciones guarda folios, filtros y cantidad
  detalle         Json?
  ip              String?
  userAgent       String?
  /// true si ocurrió dentro de una sesión de soporte del superadmin
  viaSuplantacion Boolean         @default(false)
  creadoEn        DateTime        @default(now())

  @@index([empresaId, entidad, entidadId])
  @@index([empresaId, usuarioId, creadoEn])
  @@index([empresaId, accion, creadoEn])
}

/// Operaciones ya aplicadas, por clave de idempotencia.
///
/// El celular reintenta cuando no recibe respuesta, y a veces la operación
/// SÍ se aplicó y lo que se perdió fue la respuesta. Esta tabla evita
/// aplicarla dos veces: la clave se reclama DENTRO de la misma transacción
/// que el efecto, así que nunca queda una operación aplicada sin registrar,
/// ni registrada sin aplicar.
///
/// Solo se guardan las exitosas. Un rechazo deshace la transacción entera,
/// incluida la clave: si la causa se corrige, el reintento se aplica.
model OperacionAplicada {
  empresaId String
  clave     String
  /// Respuesta original, para devolverla igual si la operación se repite.
  respuesta Json?
  creadaEn  DateTime @default(now())

  @@id([empresaId, clave])
  @@index([creadaEn])
}

// ════════════════════════════════════════════════════════════════════════════
// LA LLANTA COMO ACTIVO (R8)
// ════════════════════════════════════════════════════════════════════════════
// Las llaves foráneas van en la migración (compuestas con empresaId, como la
// orden): una llanta no puede apuntar a un cliente de otra empresa.

/// Una llanta física, del cliente, administrada por la empresa. Se sigue por
/// serial o número interno; sin ninguno de los dos no es un activo.
model Llanta {
  id            String    @id
  empresaId     String
  clienteId     String
  /// Sede de la empresa donde está guardada, cuando está en bodega.
  sedeId        String?
  /// Marcado a fuego o etiqueta: el que usa el taller para llamarla.
  numeroInterno String?
  serial        String?
  numCalor      String?
  dot           String?
  marcaId       String?
  disenoId      String?
  medida        String?
  /// bodega | montada | reencauche | reparacion | desecho (dominio llanta/activo)
  estado        String    @default("bodega")
  vehiculoId    String?
  posicion      Int?
  /// Reencauches hechos: 0 es la llanta original.
  vidas         Int       @default(0)
  /// Costo de compra (vida 0). Dinero: Decimal.
  costo         Decimal?  @db.Decimal(14, 2)
  activa        Boolean   @default(true)
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@unique([empresaId, clienteId, serial])
  @@unique([empresaId, clienteId, numeroInterno])
  @@unique([id, empresaId])
  @@index([empresaId, estado])
  @@index([empresaId, vehiculoId])
  @@index([empresaId, sedeId, estado])
}

/// Cada vida de la llanta: la original (0) y cada reencauche.
model LlantaVida {
  id                 String   @id
  empresaId          String
  llantaId           String
  numero             Int
  /// Diseño de la banda de reencauche.
  banda              String?
  reencauchadora     String?
  costo              Decimal? @db.Decimal(14, 2)
  profundidadInicial Decimal? @db.Decimal(5, 2)
  inicio             DateTime @db.Date
  creadoEn           DateTime @default(now())

  @@unique([llantaId, numero])
  @@index([empresaId, llantaId])
}

/// La historia de la llanta: dónde estuvo y qué le pasó. Nada se borra.
model LlantaMovimiento {
  id          String   @id
  empresaId   String
  llantaId    String
  /// dominio llanta/activo: ingreso, montaje, desmontaje, envio_reencauche…
  tipo        String
  fecha       DateTime @db.Date
  vehiculoId  String?
  posicion    Int?
  ordenId     String?
  kilometraje Int?
  sedeId      String?
  detalle     String?
  usuarioId   String?
  creadoEn    DateTime @default(now())

  @@index([empresaId, llantaId])
  @@index([empresaId, ordenId])
}

/// Cuántas llantas de una medida debería haber en bodega en una sede.
model StockMinimo {
  id        String @id
  empresaId String
  sedeId    String
  medida    String
  cantidad  Int

  @@unique([empresaId, sedeId, medida])
}

/// Reclamo de garantía al proveedor por una llanta que falló (R10).
model Reclamo {
  id              String    @id
  empresaId       String
  llantaId        String
  clienteId       String
  /// Marca o distribuidor al que se reclama.
  proveedor       String
  motivoRetiro    String
  /// abierto | enviado | aprobado | rechazado | cerrado (dominio llanta/retiro)
  estado          String    @default("abierto")
  fecha           DateTime  @db.Date
  valorReconocido Decimal?  @db.Decimal(14, 2)
  notas           String?
  creadoPorId     String
  creadoEn        DateTime  @default(now())
  actualizadoEn   DateTime  @updatedAt

  @@index([empresaId, estado])
  @@index([empresaId, llantaId])
}
