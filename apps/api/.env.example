# Base de datos. Con pooler (Supabase/Neon) hacen falta las dos:
# DATABASE_URL para el runtime, DIRECT_URL para las migraciones.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/tiretrack?schema=public"

# Conexión del módulo de ACCESO, con el rol tiretrack_auth.
#
# Es una conexión distinta porque el login ocurre antes de saber la empresa:
# con el rol de aplicación, buscar al usuario por correo devuelve cero filas
# y el login fallaría siempre.
#
# Ese rol solo tiene permisos sobre Usuario, SesionUsuario,
# TokenRecuperacion, Auditoria y Empresa: un fallo en el módulo de acceso no
# alcanza los datos operativos. Ver la sección "ROL DE AUTENTICACIÓN" en
# prisma/rls.sql.
DATABASE_URL_AUTH="postgresql://tiretrack_auth:clave@localhost:5432/tiretrack?schema=public"
DIRECT_URL="postgresql://usuario:clave@localhost:5432/tiretrack?schema=public"

# Autenticación
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRA="15m"
REFRESH_EXPIRA="7d"

# Almacenamiento de fotos: "r2" (producción) o "disco" (solo para probar en
# la red local, sin cuenta de R2). Con "disco" las fotos quedan en
# ALMACENAMIENTO_CARPETA y URL_PUBLICA debe ser como el TELÉFONO ve este
# equipo (su IP en la red, nunca localhost). En producción "disco" se rechaza.
ALMACENAMIENTO="r2"
# ALMACENAMIENTO_CARPETA="./archivos-locales"
# URL_PUBLICA="http://192.168.1.50:4000"

# Cierre tácito y órdenes recurrentes: cada cuántos minutos (0 los apaga).
# TRABAJOS_CADA_MINUTOS=15

# Con ALMACENAMIENTO="r2" (S3-compatible: Cloudflare R2)
S3_ENDPOINT=""
# Región del almacenamiento. En Cloudflare R2 es "auto".
S3_REGION="auto"
S3_BUCKET="tiretrack-fotos"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""

PORT=4000
